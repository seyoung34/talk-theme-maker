# Canonical site origin. MUST be the production https origin in deployed builds
# (https://talktheme.shop — non-www, no trailing slash).
#
# NEXT_PUBLIC_* values are inlined at BUILD time. A deploy build that picks up a
# developer's local `.env.local` would bake `http://localhost:3000` into every
# canonical URL, og:url, and sitemap entry. To make that failure loud instead of
# silent, `lib/seo/site.ts` rejects non-https and localhost origins: those builds
# emit no canonical, no og:url, and an empty sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console ownership verification, ONLY for a URL-prefix property.
# The production domain property is already verified with a Cloudflare DNS TXT record,
# which covers www and http variants at once and needs no build variable — prefer that.
#
# The NEXT_PUBLIC_ prefix is required even though this is not a secret: pages render per
# request inside the Cloudflare Worker, where Workers Builds' build variables no longer
# exist. Only NEXT_PUBLIC_* values are inlined into the bundle at build time.
# Even then, the build cache can reuse a previously compiled module, so changing this
# value alone may not take effect — clear the build cache or touch lib/seo/site.ts.
#
# The Naver token is NOT here. It lives in lib/seo/site.ts as a constant precisely to
# avoid the two traps above. See the comment there.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 (leave empty to keep analytics disabled)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public operator/support information shown on /support. Code defaults exist; set these to override them.
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_REPRESENTATIVE=
NEXT_PUBLIC_BUSINESS_REGISTRATION_NUMBER=
NEXT_PUBLIC_ECOMMERCE_REGISTRATION_NUMBER=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_HOURS=

# Public privacy contact information shown on /privacy. Code defaults exist; set these to override them.
NEXT_PUBLIC_PRIVACY_CONTACT_NAME=
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_CONTACT_PHONE=

# Catalog export rollout. Keep all four flags at 0 until a platform canary is approved.
# For a platform canary, set both its server flag and NEXT_PUBLIC producer flag to 1.
ASSET_CATALOG_EXPORT_ENABLED_ANDROID=0
ASSET_CATALOG_EXPORT_ENABLED_IOS=0
NEXT_PUBLIC_ASSET_CATALOG_EXPORT_ENABLED_ANDROID=0
NEXT_PUBLIC_ASSET_CATALOG_EXPORT_ENABLED_IOS=0
