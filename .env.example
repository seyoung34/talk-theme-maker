# Canonical site origin. MUST be the production https origin in deployed builds
# (https://talktheme.shop — non-www, no trailing slash).
#
# NEXT_PUBLIC_* values are inlined at BUILD time. A deploy build that picks up a
# developer's local `.env.local` would bake `http://localhost:3000` into every
# canonical URL, og:url, and sitemap entry. To make that failure loud instead of
# silent, `lib/seo/site.ts` rejects non-https and localhost origins: those builds
# emit no canonical, no og:url, and an empty sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engine ownership verification. Public values (they render into the HTML),
# but they differ per environment so they are not hardcoded. Leave empty to omit the tag.
#
# Google: prefer verifying the DOMAIN property with a Cloudflare DNS TXT record — that
# covers www and http variants at once and needs no build variable. Use this meta tag
# only if you register a URL-prefix property instead.
# Naver Search Advisor has no DNS method, so it needs this tag (or an HTML file).
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# Google Analytics 4 (leave empty to keep analytics disabled)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public operator/support information shown on /support. Code defaults exist; set these to override them.
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_REPRESENTATIVE=
NEXT_PUBLIC_BUSINESS_REGISTRATION_NUMBER=
NEXT_PUBLIC_ECOMMERCE_REGISTRATION_NUMBER=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_HOURS=

# Public privacy contact information shown on /privacy. Code defaults exist; set these to override them.
NEXT_PUBLIC_PRIVACY_CONTACT_NAME=
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_CONTACT_PHONE=
