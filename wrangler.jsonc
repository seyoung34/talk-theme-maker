{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "talk-theme-maker",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-07-07",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    // 그로블 결제창과 서명 웹훅 검증을 완료한 뒤 canary 결제를 위해 활성화한다.
    // `0`이면 /api/billing/checkout/prepare가 503으로 막힌다.
    // 대시보드 var로 두면 안 된다 — Workers Builds는 `--keep-vars` 없이 배포하므로 wrangler가
    // 배포 전에 모든 var를 지우고 이 블록만 다시 세운다. 웹훅 시크릿은 대시보드 Secret으로만 관리한다.
    "GROBLE_CHECKOUT_ENABLED": "1",
    // 운영자 Telegram 알림은 production에서 활성화한다. 배포마다 대시보드 값이 사라지지 않도록 소스에 고정한다.
    "TELEGRAM_NOTIFICATIONS_ENABLED": "1",
    // GA4_PROPERTY_ID와 GA4_SERVICE_ACCOUNT_EMAIL은 production Worker Secret으로 관리한다.
    // 평문 vars에 넣지 않아도 OpenNext가 Secret을 process.env로 주입하므로 배포 때 값을 보존한다.
    // 관리자 저장의 catalog write-shadow는 기존 운영 동작을 유지한다.
    "ASSET_CATALOG_WRITE_ENABLED": "1",
    // Phase 5 변환 canary. 범위 밖 logical asset은 기존 File/legacy 경로를 유지한다.
    "ASSET_CATALOG_EXPORT_ENABLED_ANDROID": "1",
    "ASSET_CATALOG_EXPORT_ENABLED_IOS": "1",
    "ASSET_CATALOG_EXPORT_ANDROID_ASSET_ALLOWLIST": "admin:de7633d1-e8fe-43e3-9e11-2ac929015d73",
    "ASSET_CATALOG_EXPORT_IOS_ASSET_ALLOWLIST": "admin:de7633d1-e8fe-43e3-9e11-2ac929015d73"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "talk-theme-maker"
    }
  ],
  // 공개 preview 파생물 전용. 원본은 GCS catalog에 남고 이 버킷에는 들어오지 않는다.
  // 바인딩으로만 쓰므로 장기 R2 액세스 키를 만들지 않는다. `next dev`에는 바인딩이 없어
  // 호출부가 기존 Supabase `theme-public` 경로로 fallback한다.
  "r2_buckets": [
    {
      "binding": "THEME_PREVIEW_BUCKET",
      "bucket_name": "talktheme-preview"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "triggers": {
    // Export 상태 조회와 watchdog 환급을 5분마다 실행한다. Cron 시간은 UTC 기준이다.
    "crons": ["*/5 * * * *"]
  }
}
