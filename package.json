{
  "name": "TalkTheme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/with-env.mjs supabase-local next dev",
    "build:local": "node scripts/with-env.mjs supabase-local next build",
    "start:local": "node scripts/with-env.mjs supabase-local next start",
    "check:text": "node scripts/check-text-encoding.mjs",
    "check:ios-slots": "node scripts/verify-ios-slot-metadata.mjs",
    "check:android-colors": "node scripts/verify-android-color-slots.mjs",
    "check:android-assets": "node scripts/verify-android-bundled-assets.mjs",
    "check:edge-imports": "node scripts/verify-edge-safe-imports.mjs",
    "check:ios-export": "node scripts/verify-ios-export-hardening.mjs",
    "check:admin-asset-domain": "node scripts/verify-admin-assets-domain.mjs",
    "check:slot-keys": "node scripts/generate-slot-key-reference.mjs --check",
    "docs:slot-keys": "node scripts/generate-slot-key-reference.mjs",
    "check:all": "npm run check:text && npm run check:ios-slots && npm run check:android-colors && npm run check:android-assets && npm run check:edge-imports && npm run check:ios-export && npm run check:admin-asset-domain",
    "docs:backup": "node scripts/backup-private-docs.mjs --commit --push",
    "docs:backup:dry-run": "node scripts/backup-private-docs.mjs --dry-run",
    "assets:landing": "node scripts/optimize-landing-images.mjs",
    "assets:guide": "node scripts/optimize-guide-images.mjs",
    "capture": "node scripts/capture/run.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "cf:build": "opennextjs-cloudflare build",
    "cf:build:workers": "node scripts/verify-workers-context.mjs workers && npm run cf:build",
    "cf:build:production": "node scripts/verify-workers-context.mjs build && npm run cf:build",
    "cf:deploy:production": "node scripts/verify-workers-context.mjs deploy && wrangler deploy --strict",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "lucide-react": "^1.17.0",
    "next": "^15.5.20",
    "react": "^19.0.0",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@opennextjs/cloudflare": "^1.20.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.20",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.6",
    "postcss": "^8.5.15",
    "supabase": "2.109.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.1"
  }
}
